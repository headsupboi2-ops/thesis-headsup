{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "excludeFiles": "{models/*.pkl,models/*.h5,models/*.keras,models/README.txt,__pycache__/**,scripts/typhoon_scraper_deprecated.py,scripts/train_lstm.py,scripts/backtest.py,scripts/convert_to_tflite.py,*.bat,*.sh,*.spec,requirements_local.txt,requirements_web.txt}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
